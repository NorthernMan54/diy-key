# Copy to ~/.diy-key/<instance>/diykey.env and edit; only DIYKEY_* keys are read.
# Touch ~/.diy-key/<instance>/restart to apply.

# Identity: keep stable once adopted; a fresh one needs a new MAC/device ID/GUID.
DIYKEY_IFACE=en0
DIYKEY_MAC=FCECDA000001
DIYKEY_DEVICE_ID=00000000-0000-4000-8000-000000000001
DIYKEY_GUID=00000000-0000-4000-8000-000000000002
DIYKEY_HOSTNAME=diy-key
# DIYKEY_STATE_DIR is the instance's state/ folder unless set here.

# Instance address (add it first): sudo ifconfig en0 alias 192.0.2.18 255.255.255.255
DIYKEY_BIND_IP=192.0.2.18

# Protect console, for tokenless reconnect and the PostgreSQL access rule.
DIYKEY_CONSOLE_HOST=192.0.2.1

# PostgreSQL 17 + pgvector from Homebrew; diykey_pg_init.sh creates pg/. 0 disables.
# DIYKEY_PG_BIN=/opt/homebrew/opt/postgresql@17/bin
# DIYKEY_PG=1

DIYKEY_DEBUG=false
# Firmware: factory version; a simulated update pins a newer one in state/fw_version.json.
# DIYKEY_FW_VERSION=2.2.6
# DIYKEY_DISCOVERY_FW_VERSION=aikey.rk3588.v2.2.6.0.emu.260901.0000
# Offered firmware is kept here (DIYKEY_FW_DOWNLOAD=0 skips); the fake install takes N s.
# DIYKEY_FW_DIR=~/.diy-key/firmware
# DIYKEY_FW_DOWNLOAD=1
# DIYKEY_FAKE_UPDATE_S=15
# Log rotation (read at start, needs a full restart): size in MB and files kept.
# DIYKEY_LOG_MAX_MB=50
# DIYKEY_LOG_KEEP=5

# recognizeKeyFrames: COCO ONNX detector (Ultralytics anchor-free, e.g. yolov9-s-320.onnx).
# Unset = no RAM result (and Recognize Anything not advertised).
# DIYKEY_RAM_MODEL=/path/to/yolov9-s-320.onnx

# Find Anything: CLIP ViT-L/14 image/text embeddings and the nl-search socket (torch/open_clip).
# DIYKEY_RAM_TAGS points at Protect's app/fixtures/ram_tags.csv.
# AI Key Advanced alarms (Alarm Manager natural-language rules) need all four of
# DIYKEY_CLIP, DIYKEY_RAM_MODEL, DIYKEY_RAM_TAGS and DIYKEY_NL_SEARCH on; startup warns otherwise.
# DIYKEY_CLIP=1
# 1 = CLIP in FP16 on MPS/CUDA (~1.1 GB instead of ~2.8 GB; scores within 0.3 similarity points).
# First start writes DIYKEY_CLIP_FP16_WEIGHTS (default ~/.diy-key/models/clip-ViT-L-14-quickgelu-
# openai-fp16.safetensors, 855 MB); restart once after that. docs/memory-speed-2026-11.md
# DIYKEY_CLIP_FP16=1
# DIYKEY_RAM_TAGS=/path/to/ram_tags.csv
# Optional: the firmware's word->tag links (ui-slm-runtime-engine ui_slm_word_linker.json; vendor data, keep outside the repo).
# DIYKEY_WORD_LINKER=/path/to/ui_slm_word_linker.json
# DIYKEY_NL_SEARCH=1
# Tag text blended into each stored object embedding (search rows AND alarm scores use it).
# 0.1 lifts crops matching their own tags past Protect's 50 % (raw CLIP sits ~35-40 %);
# higher = more alarm recall, less precision; 0 = raw CLIP.
# DIYKEY_CLIP_TAG_BLEND=0.1
# 1 = tag every object crop with the type Protect claims. Default: with RAM++ loaded, only when
# COCO or RAM++ sees that kind of object on the crop (a crack called "animal" stays untagged).
# DIYKEY_TRUST_CLAIMED_TYPE=0
# Animal crops keep RAM++'s species when the event's whole frames name it too; with no whole
# frames (image tasks) the crop's short side must reach this many pixels.
# DIYKEY_SPECIES_MIN_PX=160
# A claimed animal loses its animal tags when CLIP is this sure it's something else (0 = off).
# DIYKEY_CLIP_VETO=0.9

# Features advertised to Protect (getInfo featureFlags); each is off unless set here.
# DIYKEY_RAM_MODEL above also turns on Recognize Anything and retroactive processing.
# DIYKEY_FACE=1          # face recognition
# DIYKEY_LPR=1           # licence plate recognition
# DIYKEY_FACE_ENHANCE=1  # face enhancement
# DIYKEY_FACE_ENHANCE_PROVIDER=mlprogram  # coreml (default) | mlprogram | cpu. mlprogram: same
#                        # pixels as CPU, ~1 GB instead of ~3.5-5 GB, 0.5 s/face on an M1 Pro
#                        # (docs/memory-speed-2026-11.md)
# DIYKEY_VLM=mlx         # AI summary: mlx or transformers; off/0 or unset = off
# DIYKEY_VLM_QUEUE=0     # write summaries on the main task worker (default 1: own queue)
# DIYKEY_VLM_EVENT_CONTEXT=0  # summarise the whole frame like the firmware (default 1: a crop
#                        # around the object that triggered the event)
# DIYKEY_SCENE_MEMORY=1  # learn per camera what is always in the picture and leave it out of tags
#                        # and summaries (needs DIYKEY_CLIP=1, and DIYKEY_REID_MODEL for people).
#                        # Thresholds: DIYKEY_SCENE_* in docs/macos.md
# DIYKEY_DEEP_MODE=1     # advertise supportDeepMode (needs DIYKEY_VLM). Opt-in: once Protect's
#                        # Deep Understanding is on it switches RAM off on this key and sends
#                        # :7968/describe tasks instead. Re-ID embeddings are not supported.
# DIYKEY_DESC_EMBED=1    # also send a CLIP text embedding (768-d) of each deep description;
#                        # needs DIYKEY_CLIP=1; Protect's column size is unverified

# Face recognition: folder with face_detection_yunet_2023mar.onnx and
# face_recognition_sface_2021dec.onnx (default <diykey>/models; pi-port's diyport/models works).
# DIYKEY_FACE_MODELS=/path/to/models
# Licence plates (fast-alpr): plate-detector score floor and minimum plate width in px.
# DIYKEY_LPR_THRESH=0.5
# DIYKEY_LPR_MIN_PX=60
# Face enhancement: GFPGAN v1.4 ONNX (1x3x512x512); unset = the original face goes back.
# DIYKEY_FACE_ENHANCE_MODEL=/path/to/gfpgan_1.4.onnx
# AI summary model: an mlx-community repo for mlx, a local InternVL2-style path for transformers.
# DIYKEY_VLM_MODEL=mlx-community/<SmolVLM2 or Qwen3-VL-2B repo>

# recognizeKeyFrames/RequestAI task pool: workers, max queued (full = drop), max wait in s.
# DIYKEY_TASK_WORKERS=1
# DIYKEY_TASK_QUEUE_MAX=200
# DIYKEY_TASK_DROP_AGE_S=900
# Clip download + frame grabs start when a task arrives, on this many threads (0 = off).
# DIYKEY_PREFETCH_WORKERS=2

# Person re-ID (tap-to-find and reidEmbed on detections). Path to the OSNet-AIN x1.0 MSMT17
# checkpoint from Hugging Face kaiyangzhou/osnet (MIT). Runs on the Apple GPU; needs torch.
#DIYKEY_REID_MODEL=~/.diy-key/models/reid/osnet_ain_x1_0_msmt17_256x128_amsgrad_ep50_lr0.0015_coslr_b64_fb10_softmax_labsmth_flip_jitter.pth
